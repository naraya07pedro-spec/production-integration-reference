# Placeholders for `npm start`. Copy to .env (git-ignored) and fill in your own values.
# npm start does not load .env automatically: export these in your shell first.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
WEBHOOK_SECRET=replace-with-a-long-random-secret
DOWNSTREAM_URL=https://receiver.example.test/leads
DOWNSTREAM_TOKEN=replace-with-receiver-token
PORT=3000

# Only for `npm run test:db` and `npm run demo`. Point at a disposable database.
TEST_DATABASE_URL=postgresql://reference:local-demo-only@localhost:5432/reference_test
